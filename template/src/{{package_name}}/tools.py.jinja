"""The tools this server exposes. Each one goes through the guardrails.

To add a tool: write a function, decorate it with `guard.read(...)` or
`guard.write(...)`, and describe it for the model. The docstring says what the tool
does and when to use it; `Annotated[..., Field(description=...)]` documents each
parameter. Both end up in the tool definition the model reads.
"""

from __future__ import annotations

from typing import Annotated, Any

from mcp.server.mcpserver.exceptions import ToolError
from pydantic import Field

from .guardrails import Guardrails
from .store import ContactNotFound, ContactStore

ContactId = Annotated[str, Field(description="The contact's id, as returned by search (for example c001).")]
Email = Annotated[str | None, Field(description="Email address. Omit to leave it unchanged.")]
Phone = Annotated[str | None, Field(description="Phone number, in any format. Omit to leave it unchanged.")]
Company = Annotated[str | None, Field(description="Company or organization name. Omit to leave it unchanged.")]


def register_tools(guard: Guardrails, store: ContactStore) -> None:
    def get_or_fail(contact_id: str) -> dict[str, Any]:
        try:
            return store.get(contact_id)
        except ContactNotFound:
            raise ToolError(f"No contact with id {contact_id!r}. Search to find the right id.") from None

    @guard.read(name="{{ tool_prefix }}_search_contacts")
    async def search_contacts(
        query: Annotated[str, Field(description="Text to look for, such as a name, company or email domain.")],
        limit: Annotated[int, Field(description="Most results to return, from 1 to 100.", ge=1, le=100)] = 10,
    ) -> list[dict[str, Any]]:
        """Find contacts whose name, company or any other field contains the query (case-insensitive).

        Use this first when you don't know a contact's id. Each result includes the id
        to pass to the other contact tools. Masked fields show as "[masked]".
        """
        return store.search(query, limit)

    @guard.read(name="{{ tool_prefix }}_get_contact")
    async def get_contact(contact_id: ContactId) -> dict[str, Any]:
        """Get every field of one contact by its id.

        Use this when you already have an id, for example from search results. If you
        only know a name or company, use search instead.
        """
        return get_or_fail(contact_id)

    @guard.write(name="{{ tool_prefix }}_create_contact", destructive=False)
    async def create_contact(
        name: Annotated[str, Field(description="The contact's full name.")],
        email: Email = None,
        phone: Phone = None,
        company: Company = None,
    ) -> dict[str, Any]:
        """Create a new contact and return it, including its new id.

        Search first to avoid creating a duplicate of someone who already exists.
        """
        fields = {"name": name, "email": email, "phone": phone, "company": company}
        return store.create({k: v for k, v in fields.items() if v is not None})

    @guard.write(name="{{ tool_prefix }}_update_contact", destructive=False, idempotent=True)
    async def update_contact(
        contact_id: ContactId, email: Email = None, phone: Phone = None, company: Company = None
    ) -> dict[str, Any]:
        """Change a contact's email, phone or company and return the updated contact.

        Pass only the fields you mean to change. Never pass "[masked]": it stands in for
        a hidden value, and the call is refused.
        """
        get_or_fail(contact_id)
        fields = {"email": email, "phone": phone, "company": company}
        return store.update(contact_id, {k: v for k, v in fields.items() if v is not None})

    @guard.write(
        name="{{ tool_prefix }}_delete_contact",
        destructive=True,
        confirm_message="Permanently delete contact {contact_id}?",
    )
    async def delete_contact(contact_id: ContactId) -> dict[str, Any]:
        """Permanently delete a contact. This can't be undone.

        The user is asked to confirm before anything is deleted. If they decline, the
        contact is left as it was.
        """
        get_or_fail(contact_id)
        return store.delete(contact_id)
