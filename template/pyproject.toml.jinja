[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = {{ description | tojson }}
readme = "README.md"
license = "{{ license }}"
authors = [{ name = {{ author_name | tojson }}{% if author_email %}, email = "{{ author_email }}"{% endif %} }]
requires-python = ">=3.10"
dependencies = [
    "mcp>=2.3,<3",
    "pyyaml>=6,<7",
]

[project.optional-dependencies]
dev = ["pytest>=8", "anyio>=4"]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.server:main"

[project.urls]
Repository = "https://github.com/{{ github_user }}/{{ project_slug }}"

[build-system]
requires = ["hatchling>=1.26"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
