async def test_a_write_with_ordinary_text_in_a_listed_field_goes_through():
    server, saved = notes_server(**LISTED, confirm="off")
    async with Client(server) as client:
        result = await client.call_tool("set_note", {"note_id": "n1", "notes": "call me tomorrow, ada@example.org"})
    assert not result.is_error
    assert saved == ["call me tomorrow, ada@example.org"]  # writing real text is allowed; hiding applies to what is read


SCANNED = [
    # hidden
    ("write to ada@example.org now", "write to [masked] now"),
    ("<Ada.Park+crm@mail.example.co.uk>", "<[masked]>"),
    ("'john.o'brien@example.org' and ADA@EXAMPLE.ORG", "'[masked]' and [masked]"),
    ("ada@example.org;mei@example.org,sam@example.org", "[masked];[masked],[masked]"),
    ("call 555-0101", "call [masked]"),
    ("call 555-0101.", "call [masked]."),
    ("tel:555-0101 ext 22", "tel:[masked] ext 22"),
    ("555-0101, 555-0102", "[masked], [masked]"),
    ("(555) 010-1234", "[masked]"),
    ("(555)010-1234", "[masked]"),
    ("555.010.1234", "[masked]"),
    ("1-800-555-0101", "[masked]"),
    ("+1 555 010 1234", "[masked]"),
    ("+1-555-010-1234", "[masked]"),
    ("+1 (555) 010-1234", "[masked]"),
    ("+44 20 7946 0958", "[masked]"),
    ("+44 (0)20 7946 0958", "[masked]"),
    ("+15550101234", "[masked]"),
    # left alone
    ("ada@example", "ada@example"),  # no top-level domain
    ("ask @ada on the forum", "ask @ada on the forum"),
    ("2026-11-11", "2026-11-11"),
    ("2026-11-11 10:30:00", "2026-11-11 10:30:00"),
    ("11-11-2026", "11-11-2026"),
