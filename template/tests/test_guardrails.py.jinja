@pytest.mark.parametrize(("text", "expected"), SCANNED)
def test_what_the_built_in_patterns_hide_and_what_they_leave(text, expected):
    policy = Policy(mask_pattern_fields=frozenset({"notes"}))
    assert policy.mask({"notes": text}) == {"notes": expected}


def test_a_long_run_of_pattern_characters_is_scanned_quickly():
    import time

    policy = Policy(mask_pattern_fields=frozenset({"notes"}))
    nasty = "a" * 100_000 + " " + "1 " * 50_000 + "-".join(["12"] * 20_000)
    started = time.monotonic()
    policy.mask({"notes": nasty})
    assert time.monotonic() - started < 5


def test_mask_patterns_in_the_policy_file():
    policy = Policy.from_yaml("mask_patterns:\n  fields: [Notes, description]\n  kinds: [email]\n")
    assert policy.mask_pattern_fields == {"notes", "description"}
    assert policy.mask_pattern_kinds == {"email"}


def test_the_example_in_the_default_policy_is_valid_when_uncommented():
    from importlib import resources

    text = resources.files("{{ package_name }}").joinpath("default_policy.yaml").read_text()
    example = ("# mask_patterns:", "#   fields:", "#   kinds:")
    lines = [line.removeprefix("# ") if line.startswith(example) else line for line in text.splitlines()]
    policy = Policy.from_yaml("\n".join(lines))
    assert policy.mask_pattern_fields == {"notes", "description"}
    assert policy.mask_pattern_kinds == {"email", "phone"}


def test_every_kind_is_used_unless_the_policy_narrows_them():
    policy = Policy.from_yaml("mask_patterns:\n  fields: [notes]\n")
    assert policy.mask_pattern_kinds == {"email", "phone"}
    assert Policy().mask_pattern_fields == frozenset()  # and with no section, nothing is scanned


@pytest.mark.parametrize(
    "text",
    [
        "mask_patterns:\n  feilds: [notes]\n",  # a typo in a key
        "mask_patterns:\n  fields: [notes]\n  kinds: [emial]\n",  # a typo in a kind
        "mask_patterns:\n  fields: [notes]\n  kinds: []\n",  # nothing to look for
        "mask_patterns:\n  fields: []\n",  # nothing to scan
        "mask_patterns:\n  kinds: [email]\n",  # no fields
        "mask_patterns: [notes]\n",  # the wrong shape
