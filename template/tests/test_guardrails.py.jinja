async def test_sync_tools_run_off_the_event_loop():
    import threading

    from mcp.server.mcpserver import MCPServer

    from {{ package_name }}.guardrails import Guardrails

    server = MCPServer("t")
    guard = Guardrails(server, Policy())

    @guard.read(name="where")
    def where() -> dict:
        return {"thread": threading.current_thread().name}

    async with Client(server) as client:
        result = await client.call_tool("where", {})
    assert json.loads(result.content[0].text)["thread"] != threading.current_thread().name


