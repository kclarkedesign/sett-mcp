async def test_generic_prompt_lists_only_the_arguments_given():
    server, _ = make_server(writes_enabled=True, confirm="all_writes", mask_fields=frozenset({"email"}))
    prompts = []

    async def callback(context, params):
        prompts.append(params.message)
        return ElicitResult(action="decline")

    async with Client(server, elicitation_callback=callback) as client:
        await client.call_tool(UPDATE, {"contact_id": "c1", "company": "Harbor"})
    assert prompts == [f"Allow {UPDATE}(contact_id='c1', company='Harbor')?"]


async def test_masked_fields_never_reach_the_model():
    server, _ = make_server(mask_fields=frozenset({"email", "phone"}))
    async with Client(server) as client:
        result = await client.call_tool(GET, {"contact_id": "c1"})
    contact = result.structured_content
    assert contact["name"] == "Ada"
    assert contact["email"] == MASK and contact["phone"] == MASK
    assert "ada@example.org" not in result.content[0].text


async def test_audit_log_records_each_call_with_masked_arguments(tmp_path):
    log = tmp_path / "audit.jsonl"
    server, _ = make_server(writes_enabled=True, confirm="off", mask_fields=frozenset({"email"}), audit_path=log)
    async with Client(server) as client:
        await client.call_tool(CREATE, {"name": "Bo", "email": "bo@example.org"})
        await client.call_tool(GET, {"contact_id": "missing"})
    entries = [json.loads(line) for line in log.read_text().splitlines()]
    assert [(e["tool"], e["kind"], e["outcome"]) for e in entries] == [(CREATE, "write", "ok"), (GET, "read", "error")]
    assert entries[0]["arguments"]["email"] == MASK


def read_audit(log):
    return [json.loads(line) for line in log.read_text().splitlines()]


@pytest.mark.parametrize("mode", PROTOCOLS)
async def test_audit_rows_name_the_client_that_made_the_call(tmp_path, mode):
    log = tmp_path / "audit.jsonl"
    server, _ = make_server(audit_path=log)
    client_info = Implementation(name="Test Client", version="9.9")
    async with Client(server, mode=mode, client_info=client_info) as client:
        await client.call_tool(GET, {"contact_id": "c1"})
    (row,) = read_audit(log)
    assert (row["client_name"], row["client_version"]) == ("Test Client", "9.9")
    assert "user_agent" not in row  # there is no HTTP request in this connection


@pytest.mark.parametrize("mode", PROTOCOLS)
async def test_a_refusal_for_a_client_that_cannot_confirm_names_the_client(tmp_path, mode):
    log = tmp_path / "audit.jsonl"
    server, _ = make_server(writes_enabled=True, audit_path=log)
    client_info = Implementation(name="No Prompts", version="1.2")
    async with Client(server, mode=mode, client_info=client_info) as client:  # no elicitation support
        result = await client.call_tool(DELETE, {"contact_id": "c1"})
    assert result.is_error
    (row,) = read_audit(log)
    assert (row["outcome"], row["client_name"], row["client_version"]) == ("blocked", "No Prompts", "1.2")


@pytest.mark.parametrize("mode", PROTOCOLS)
async def test_a_client_name_is_untrusted_text_so_it_is_capped_and_cleaned(tmp_path, mode):
    # Any client can claim any name. A NUL would make Postgres refuse the whole row, so a hostile
    # client could keep its own calls out of the audit table.
    log = tmp_path / "audit.jsonl"
    server, _ = make_server(audit_path=log)
    client_info = Implementation(name="Evil\u0000\nClient " + "x" * 1000, version="1 \t.0")
    async with Client(server, mode=mode, client_info=client_info) as client:
        await client.call_tool(GET, {"contact_id": "c1"})
    (row,) = read_audit(log)
    assert row["client_name"].startswith("Evil Client x") and len(row["client_name"]) == 200
    assert row["client_version"] == "1 .0"
    assert all(char.isprintable() for value in (row["client_name"], row["client_version"]) for char in value)


def test_untrusted_text_loses_what_postgres_would_refuse():
    from {{ package_name }}.guardrails import _untrusted

    assert _untrusted("a\u0000b\ud800c") == "a b c"  # NUL and a lone surrogate
    assert _untrusted("  Claude \n Code  ") == "Claude Code"
    assert _untrusted("   ") is None and _untrusted("") is None and _untrusted(5) is None and _untrusted(None) is None


async def test_the_client_name_never_decides_anything():
    # A client that calls itself something official gets no more than any other.
    server, store = make_server(writes_enabled=True)
    client_info = Implementation(name="Claude Desktop", version="999")
    async with Client(server, client_info=client_info) as client:  # no elicitation support
        result = await client.call_tool(DELETE, {"contact_id": "c1"})
    assert result.is_error and store.get("c1")


# --- Pattern masking: personal data inside the free-text fields you name ---------------

NOTE = {
    "id": "n1",
    "title": "Call ada@example.org",  # not a listed field, so left alone
    "notes": "Call Ada at 555-0101 or ada@example.org tomorrow.",
    "nested": {
        "description": ["Mei: +1 (555) 010-1234", {"text": "mei@example.org"}],
    },
    "when": "2026-11-11 10:30",
    "ref": "ticket 1234 for order 1234567890",
}
LISTED = {"mask_pattern_fields": frozenset({"notes", "description"})}


class Note(BaseModel):
    notes: str


def notes_server(**policy):
    """A server with a read tool that returns NOTE and write tools that keep what they are given."""
    saved = []
    server = MCPServer("t")
    guard = Guardrails(server, Policy(writes_enabled=True, **policy))

    @guard.read(name="get_note")
    def get_note() -> dict:
        return NOTE

    @guard.write(name="set_note", destructive=False)
    def set_note(note_id: str, notes: str) -> dict:
        saved.append(notes)
        return {"id": note_id}

    @guard.write(name="set_note_model", destructive=False)
    def set_note_model(note: Note) -> dict:
        saved.append(note.notes)
        return {"id": "n1"}

    @guard.write(name="replace_note", destructive=True, confirm_message="Replace note {note_id} with: {notes}")
    def replace_note(note_id: str, notes: str) -> dict:
        saved.append(notes)
        return {"id": note_id}

    @guard.write(name="replace_note_model", destructive=True, confirm_message="Replace with {note}")
    def replace_note_model(note: Note) -> dict:
        saved.append(note.notes)
        return {"id": "n1"}

    @guard.write(name="replace_note_dict", destructive=True, confirm_message="Replace with {note}")
    def replace_note_dict(note: dict) -> dict:
        saved.append(note["notes"])
        return {"id": "n1"}

    return server, saved


async def read_note(**policy):
    server, _ = notes_server(**policy)
    async with Client(server) as client:
        return json.loads((await client.call_tool("get_note", {})).content[0].text)


async def test_pattern_masking_replaces_matches_in_place_and_leaves_the_rest_readable():
    note = await read_note(**LISTED)
    assert note["notes"] == "Call Ada at [masked] or [masked] tomorrow."


async def test_pattern_masking_reaches_nested_text_in_a_listed_field():
    note = await read_note(**LISTED)
    assert note["nested"]["description"] == ["Mei: [masked]", {"text": "[masked]"}]


async def test_pattern_masking_leaves_unlisted_fields_and_ordinary_numbers_alone():
    note = await read_note(**LISTED)
    for key in ("id", "title", "when", "ref"):  # title holds an email, but it is not a listed field
        assert note[key] == NOTE[key], key


async def test_nothing_is_scanned_unless_the_policy_lists_fields():
    assert await read_note() == NOTE


async def test_only_the_listed_kinds_are_hidden():
    note = await read_note(**LISTED, mask_pattern_kinds=frozenset({"email"}))
    assert note["notes"] == "Call Ada at 555-0101 or [masked] tomorrow."


async def test_a_whole_field_mask_wins_over_pattern_masking():
    note = await read_note(**LISTED, mask_fields=frozenset({"notes"}))
    assert note["notes"] == MASK


async def test_the_audit_log_holds_the_masked_text(tmp_path):
    log = tmp_path / "audit.jsonl"
    server, saved = notes_server(**LISTED, confirm="off", audit_path=log)
    async with Client(server) as client:
        await client.call_tool("set_note", {"note_id": "n1", "notes": "reach me at ada@example.org"})
    assert saved == ["reach me at ada@example.org"]  # the tool itself gets the real text
    (row,) = [json.loads(line) for line in log.read_text().splitlines()]
    assert row["arguments"]["notes"] == "reach me at [masked]"


async def test_a_custom_confirmation_message_shows_listed_free_text_masked_too():
    # Codex, round 1: only the generic prompt was masked, so {notes} in a custom message leaked.
    server, saved = notes_server(**LISTED)
    prompts = []

    async def callback(context, params):
        prompts.append(params.message)
        return ElicitResult(action="accept", content={})

    async with Client(server, elicitation_callback=callback) as client:
        await client.call_tool("replace_note", {"note_id": "n1", "notes": "reach me at ada@example.org"})
    assert prompts == ["Replace note n1 with: reach me at [masked]"]
    assert saved == ["reach me at ada@example.org"]  # what is written is still the real text


@pytest.mark.parametrize("tool", ["replace_note_model", "replace_note_dict"])
async def test_a_custom_confirmation_message_scans_listed_fields_inside_structured_arguments(tool):
    # Codex, round 2: only an argument whose own name is listed was scanned; here `note` is not, but the
    # `notes` inside it is, and the message prints the whole value.
    server, saved = notes_server(**LISTED)
    prompts = []

    async def callback(context, params):
        prompts.append(params.message)
        return ElicitResult(action="accept", content={})

    note = {"notes": "reach me at ada@example.org"}
    async with Client(server, elicitation_callback=callback) as client:
        await client.call_tool(tool, {"note": note})
    assert prompts == ["Replace with {'notes': 'reach me at [masked]'}"]
    assert saved == ["reach me at ada@example.org"]


async def test_the_confirmation_prompt_shows_the_masked_text():
    server, saved = notes_server(**LISTED, confirm="all_writes")
    prompts = []

    async def callback(context, params):
        prompts.append(params.message)
        return ElicitResult(action="accept", content={})

    async with Client(server, elicitation_callback=callback) as client:
        await client.call_tool("set_note", {"note_id": "n1", "notes": "reach me at ada@example.org"})
    assert prompts == ["Allow set_note(note_id='n1', notes='reach me at [masked]')?"]
    assert saved == ["reach me at ada@example.org"]


@pytest.mark.parametrize("confirm", ["off", "all_writes"])
@pytest.mark.parametrize("notes", ["call me at [masked]", "[masked]", "x [masked] y [masked]"])
async def test_a_write_that_passes_the_placeholder_back_in_a_listed_field_is_refused(confirm, notes):
    server, saved = notes_server(**LISTED, confirm=confirm)
    prompts = []

    async def callback(context, params):
        prompts.append(params.message)
