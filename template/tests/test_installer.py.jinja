@pytest.mark.parametrize(("code", "stderr", "ok"), [(1, "Permission denied: ~/.claude.json", False), (1, "No MCP server found with name", True)])
def test_claude_code_remove_reports_real_failures(tmp_path, monkeypatch, code, stderr, ok):
    _home(tmp_path, monkeypatch)
    monkeypatch.setattr(installer.shutil, "which", lambda name: "/bin/claude" if name == "claude" else None)

    class Done:
        returncode = code
        stdout = ""

    Done.stderr = stderr
    said = []
    assert installer.install("claude-code", remove=True, say=said.append, run=lambda argv, **kw: Done()) is ok
    assert ("failed" in said[0]) is not ok


@pytest.mark.parametrize("quote", ['"' * 3, "'" * 3])
def test_codex_leaves_header_lookalikes_inside_multiline_strings_alone(tmp_path, monkeypatch, quote):
    _home(tmp_path, monkeypatch)
    config = tmp_path / ".codex/config.toml"
    config.parent.mkdir()
    note = f"[mcp_servers.{installer.SERVER_KEY}]\nthis is just text\n[other]"
    original = f"notes = {quote}\n{note}\n{quote}\n\n[mcp_servers.other]\ncommand = \"keep\"\n"
    config.write_text(original)
    assert installer.install("codex", say=lambda _: None)
    text = config.read_text()
    assert text.startswith(original.rstrip())  # the string and the other table, untouched
    assert text.count(f"[mcp_servers.{installer.SERVER_KEY}]") == 2  # the text one + the real one
    tomllib = pytest.importorskip("tomllib") if installer.sys.version_info >= (3, 11) else pytest.importorskip("tomli")
    parsed = tomllib.loads(text)
    assert parsed["notes"].strip() == note and installer.SERVER_KEY in parsed["mcp_servers"]


