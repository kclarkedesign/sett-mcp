def test_dry_run_shows_only_this_servers_entry(tmp_path, monkeypatch):
    _home(tmp_path, monkeypatch)
    (tmp_path / ".cursor").mkdir()
    (tmp_path / ".cursor/mcp.json").write_text('{"mcpServers": {"other": {"command": "secret-path"}}, "account": "id-123"}')
    (tmp_path / ".codex").mkdir()
    (tmp_path / ".codex/config.toml").write_text('token_note = "private"\n')
    said = []
    installer.install("cursor", dry_run=True, say=said.append)
    installer.install("codex", dry_run=True, say=said.append)
    shown = "\n".join(said)
    assert installer.SERVER_KEY in shown
    assert "secret-path" not in shown and "id-123" not in shown and "private" not in shown
    assert (tmp_path / ".cursor/mcp.json").read_text().count("other") == 1  # nothing written


@pytest.mark.parametrize(
    "header",
    [
        f"[mcp_servers.{installer.SERVER_KEY}] # added by hand",
        f'[ mcp_servers . "{installer.SERVER_KEY}" ]',
        f"[mcp_servers.'{installer.SERVER_KEY}']",
    ],
)
def test_codex_recognises_its_table_however_it_is_spelled(tmp_path, monkeypatch, header):
    _home(tmp_path, monkeypatch)
    config = tmp_path / ".codex/config.toml"
    config.parent.mkdir()
    config.write_text(f'{header}\ncommand = "old"\n\n[mcp_servers.other]\ncommand = "keep"\n')
    assert installer.install("codex", say=lambda _: None)
    text = config.read_text()
    assert '"old"' not in text and '"keep"' in text
    assert text.count(f"[mcp_servers.{installer.SERVER_KEY}]") == 1  # one table, not a duplicate


