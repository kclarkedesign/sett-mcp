def test_all_installs_only_where_a_client_is_found(tmp_path, monkeypatch):
    _home(tmp_path, monkeypatch)
    monkeypatch.setattr(installer.shutil, "which", lambda name: None)
    (tmp_path / ".codex").mkdir()
    installer.install("all", say=lambda _: None)
    assert (tmp_path / ".codex/config.toml").exists()
    assert not (tmp_path / ".cursor").exists() and not (tmp_path / ".config/Claude").exists()


def test_broken_json_is_left_alone(tmp_path, monkeypatch):
    _home(tmp_path, monkeypatch)
    (tmp_path / ".cursor").mkdir()
    (tmp_path / ".cursor/mcp.json").write_text("{not json")
    said = []
    installer.install("cursor", say=said.append)
    assert (tmp_path / ".cursor/mcp.json").read_text() == "{not json"
    assert "isn't valid JSON" in said[0]
