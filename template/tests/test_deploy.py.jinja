def test_users_add_grant_revoke_list():
    supabase = FakeSupabase()
    api = Supabase("token", REF, supabase)
    said = []
    deploy.add_user(api, "ada@example.org", writer=True, say=said.append)
    assert supabase.users["ada@example.org"] == {"sett_role": "writer"}
    created = supabase.sent("POST", "/auth/v1/admin/users")[0]
    assert created[2]["apikey"] == "sb_secret_y" and "Authorization" not in created[2]

    deploy.set_writer(api, "Ada@Example.org", False, say=said.append)  # emails match without case
    assert supabase.users["ada@example.org"] == {}
    assert supabase.sent("PUT", "/admin/users/id-ada@example.org")[0][3] == {"app_metadata": {"sett_role": None}}
    deploy.set_writer(api, "ada@example.org", True, say=said.append)
    assert supabase.users["ada@example.org"] == {"sett_role": "writer"}
    assert not supabase.sent("POST", "/database/query")  # roles never go through SQL

    deploy.list_users(api, say=said.append)
    assert said[-1].startswith("ada@example.org  writer")

    with pytest.raises(DeployError, match="Add them first"):
        deploy.set_writer(api, "nobody@example.org", True, say=said.append)


