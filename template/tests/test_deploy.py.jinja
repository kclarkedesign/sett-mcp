# --- creating the Supabase project, and reusing `supabase login` --------------------------

TOKEN = "sbp_" + "a" * 40


class FakeAccount(FakeSupabase):
    """Adds organizations, project creation and a project that takes a few polls to start."""

    def __init__(self, orgs=None, polls_until_healthy=2, **kw):
        super().__init__(**kw)
        self.orgs = orgs if orgs is not None else [{"id": "1", "slug": "kirk-org", "name": "Kirk"}]
        self.polls = polls_until_healthy
        self.create_status = 201

    def __call__(self, method, url, headers, body):
        data = json.loads(body) if body else None
        if url == "https://api.supabase.com/v1/organizations":
            self.calls.append((method, url, dict(headers), data))
            return 200, json.dumps(self.orgs).encode()
        if url == "https://api.supabase.com/v1/projects" and method == "POST":
            self.calls.append((method, url, dict(headers), data))
            if self.create_status >= 400:
                return self.create_status, b'{"message":"free project limit reached"}'
            return 201, json.dumps({"ref": REF, "status": "COMING_UP"}).encode()
        if url.endswith(f"/v1/projects/{REF}/health?services=auth,db,rest"):
            self.calls.append((method, url, dict(headers), data))
            self.polls -= 1
            status = "ACTIVE_HEALTHY" if self.polls <= 0 else "COMING_UP"
            return 200, json.dumps([{"name": n, "status": status} for n in ("auth", "db", "rest")]).encode()
        return super().__call__(method, url, headers, body)


def create(account, **kw):
    clock = iter(range(0, 10_000, 5))
    return deploy.create_supabase_project(
        deploy.SupabaseAccount(TOKEN, account), "my-server", say=lambda _: None, sleep=lambda _: None,
        clock=lambda: next(clock), **kw,
    )


def test_creates_a_project_and_waits_until_it_is_healthy():
    account = FakeAccount(polls_until_healthy=3)
    said = []
    clock = iter(range(0, 10_000, 5))
    ref = deploy.create_supabase_project(
        deploy.SupabaseAccount(TOKEN, account), "my-server", say=said.append, sleep=lambda _: None, clock=lambda: next(clock)
    )
    assert ref == REF
    (call,) = account.sent("POST", "/v1/projects")
    body = call[3]
    assert body["db_pass"] not in "\n".join(said)  # never printed
    assert body["name"] == "my-server" and body["organization_slug"] == "kirk-org"
    assert body["region_selection"] == {"type": "smartGroup", "code": "americas"}
    assert len(body["db_pass"]) == 24 and body["db_pass"].isalnum()
    assert len(account.sent("GET", "/health?services=auth,db,rest")) == 3


