    _, _, vercel = run()
    env_commands = vercel.ran("env")
    assert env_commands and all("--environment" in c for c in env_commands)
    assert not vercel.ran("project", "add")  # `vercel link --yes --project` creates the project


def test_older_vercel_clis_get_the_older_forms(run):
    class OldCli(FakeVercel):
        def __call__(self, argv, stdin):
            args = argv[1 : argv.index("--cwd")]
            if "--environment" in args:  # not known to this CLI
                self.commands.append(argv)
                return 1, "", "unknown option --environment"
            if args[0] == "link" and not self.ran("project", "add"):
                self.commands.append(argv)
                return 1, "", "Project not found"
            return super().__call__(argv, stdin)

    _, _, vercel = run(vercel=OldCli())
    assert vercel.ran("project", "add") and len(vercel.ran("link")) == 2
    assert vercel.env[f"{PREFIX}_SUPABASE_URL"] == f"https://{REF}.supabase.co"
    old_adds = [c for c in vercel.ran("env", "add") if "--environment" not in c]
    assert old_adds and old_adds[0][4] == "production"  # vercel env add NAME production --force
    # The lookup fell back once; later commands went straight to the older form.
    assert len([c for c in vercel.ran("env") if "--environment" in c]) == 1
