"""`deploy vercel --auth supabase` and `users`, against stand-ins for Vercel and Supabase.

The stand-ins record every command and request, so these tests check what the deploy
would change, in what order, and that it stops before changing anything it shouldn't.
"""

from __future__ import annotations

import json
from pathlib import Path

import pytest

from {{ package_name }} import deploy
from {{ package_name }}.deploy import DeployError, DeployOptions, Supabase, Vercel

PREFIX = "{{ env_prefix }}"
REF = "abcdefghijklmnopqrst"
HOST = "my-server.vercel.app"
RESOURCE = f"https://{HOST}/mcp"


class FakeSupabase:
    """Answers the Management API, the Auth admin API, the JWKS and the deployed server."""

    def __init__(self, *, keys=None, signing_keys=True, site_url="http://localhost:3000", users=()):
        self.calls = []
        self.keys = keys if keys is not None else [
            {"type": "publishable", "api_key": "sb_publishable_x", "name": "default"},
            {"type": "secret", "api_key": "sb_secret_y", "name": "default"},
        ]
        self.signing = [{"kty": "EC", "kid": "k"}] if signing_keys else []
        self.auth = {"site_url": site_url, "external_github_enabled": False}
        self.users = {u.lower(): {} for u in users}
        self.server_status = 401

    def __call__(self, method, url, headers, body):
        data = json.loads(body) if body else None
        self.calls.append((method, url, dict(headers), data))
        api = f"https://api.supabase.com/v1/projects/{REF}"
        if url == api:
            return 200, json.dumps({"name": "sett-demo", "status": "ACTIVE_HEALTHY"}).encode()
        if url == f"{api}/api-keys?reveal=true" and method == "GET":
            return 200, json.dumps(self.keys).encode()
        if url == f"{api}/api-keys?reveal=true" and method == "POST":
            key = {"type": "secret", "api_key": "sb_secret_new", "name": data["name"]}
            self.keys.append(key)
            return 201, json.dumps(key).encode()
        if url == f"{api}/config/auth":
            if method == "PATCH":
                self.auth |= data
            return 200, json.dumps(self.auth).encode()
        if url == f"{api}/database/query":
            return 201, b"[]"
        if url == f"https://{REF}.supabase.co/auth/v1/.well-known/jwks.json":
            return 200, json.dumps({"keys": self.signing}).encode()
        admin = f"https://{REF}.supabase.co/auth/v1/admin/users"
        if url == admin and method == "POST":
            if data["email"].lower() in self.users:
                return 422, b'{"code":"email_exists"}'
            self.users[data["email"].lower()] = data["app_metadata"]
            return 200, b"{}"
        if url.startswith(admin + "?") and method == "GET":
            users = [{"id": f"id-{e}", "email": e, "app_metadata": m} for e, m in self.users.items()]
            return 200, json.dumps({"users": users}).encode()
        if url.startswith(admin + "/id-") and method == "PUT":
            email = url.removeprefix(admin + "/id-")
            for key, value in data["app_metadata"].items():
                if value is None:
                    self.users[email].pop(key, None)
                else:
                    self.users[email][key] = value
            return 200, b"{}"
        if url == f"https://{HOST}/.well-known/oauth-protected-resource/mcp":
            return 200, json.dumps({"resource": RESOURCE}).encode()
        if url.endswith("/.well-known/oauth-protected-resource/mcp"):
            return 421, b"Misdirected Request"  # the server answers only on its production host
        if url == f"https://{HOST}/mcp":
            return self.server_status, b""
        if url == f"https://{HOST}/oauth/consent":
            return 200, b"<html>"
        return 404, b"not found"

    def sent(self, method, suffix):
        return [c for c in self.calls if c[0] == method and c[1].endswith(suffix)]


class FakeVercel:
    def __init__(self, existing_env=()):
        self.commands = []
        self.existing_env = set(existing_env)
        self.env = {}

    def __call__(self, argv, stdin):
        self.commands.append(argv)
        args = argv[1 : argv.index("--cwd")]
        if args[0] == "whoami":
            return 0, "kirk\n", ""
        if args[:2] == ["teams", "ls"]:
            teams = [{"slug": "other-team", "current": False}, {"slug": "kirk-projects", "current": True}]
            return 0, json.dumps({"teams": teams}), ""
        if args[:2] == ["env", "ls"]:
            return 0, "\n".join(sorted(self.existing_env)), ""
        if args[:2] == ["env", "add"]:
            self.env[args[2]] = stdin
            return 0, "", ""
        if args[0] == "deploy":
            return 0, "https://my-server-abc123-kirk.vercel.app\n", "Building...\n"
        if args[0] == "inspect":
            aliases = [HOST, "my-server-kirk.vercel.app", "my-server-git-main-kirk.vercel.app"]
            return 0, json.dumps({"aliases": aliases}), ""
        return 0, "", ""

    def ran(self, *prefix):
        return [c for c in self.commands if c[1 : 1 + len(prefix)] == list(prefix)]


@pytest.fixture
def run(tmp_path):
    def run(supabase=None, vercel=None, **options):
        supabase = supabase or FakeSupabase()
        vercel = vercel or FakeVercel()
        opts = DeployOptions(
            vercel_project="my-server", env_prefix=PREFIX, cwd=tmp_path, say=lambda _: None, sleep=lambda _: None, **options
        )
        url = deploy.deploy(opts, Supabase("token", REF, supabase), Vercel(tmp_path, run=vercel), request=supabase)
        return url, supabase, vercel

    return run


def test_deploy_sets_everything_up(run, tmp_path):
    url, supabase, vercel = run()
    assert url == RESOURCE

    assert vercel.env[f"{PREFIX}_SUPABASE_URL"] == f"https://{REF}.supabase.co"
    assert vercel.env[f"{PREFIX}_SUPABASE_PUBLISHABLE_KEY"] == "sb_publishable_x"
    assert vercel.env[f"{PREFIX}_SUPABASE_SECRET_KEY"] == "sb_secret_y"
    assert len(vercel.env[f"{PREFIX}_REQUEST_STATE_KEY"]) >= 32
    assert vercel.env[f"{PREFIX}_ENABLE_WRITES"] == "false"  # stated on every deploy

    queries = [c[3]["query"] for c in supabase.sent("POST", "/database/query")]
    assert "create table if not exists public.sett_audit" in queries[0]
    assert "grant insert on table public.sett_audit to service_role" in queries[0]  # newer projects need it
    assert f"resource text := '{RESOURCE}';" in queries[1]

    auth = supabase.sent("PATCH", "/config/auth")[0][3]
    assert auth == {
        "site_url": f"https://{HOST}",
        "disable_signup": True,
        "oauth_server_enabled": True,
        "oauth_server_allow_dynamic_registration": True,
        "oauth_server_authorization_path": "/oauth/consent",
        "hook_custom_access_token_enabled": True,
        "hook_custom_access_token_uri": "pg-functions://postgres/public/sett_access_token_hook",
    }

    state = json.loads((tmp_path / deploy.STATE_FILE).read_text())
    assert state == {
        "supabase_project": REF,
        "vercel_project": "my-server",
        "vercel_scope": "kirk-projects",
        "url": f"https://{HOST}",
    }
    assert "sb_secret" not in (tmp_path / deploy.STATE_FILE).read_text()


def test_steps_run_in_a_safe_order(run):
    _, supabase, vercel = run()
    assert vercel.ran("link") and vercel.ran("deploy")
    assert vercel.commands.index(vercel.ran("env", "add")[-1]) < vercel.commands.index(vercel.ran("deploy")[0])
    # The hook exists before Supabase is told to call it.
    sql_at = next(i for i, c in enumerate(supabase.calls) if c[1].endswith("/database/query"))
    patch_at = next(i for i, c in enumerate(supabase.calls) if c[0] == "PATCH")
    assert sql_at < patch_at


