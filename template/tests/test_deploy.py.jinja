def test_a_refused_token_stops_the_wait_at_once():
    class Refused(FakeAccount):
        def __call__(self, method, url, headers, body):
            if url.endswith(f"/v1/projects/{REF}") and method == "GET":
                return 401, b'{"message":"Unauthorized"}'
            return super().__call__(method, url, headers, body)

    sleeps = []
    with pytest.raises(DeployError, match="access token"):
        deploy.wait_until_ready(Supabase(TOKEN, REF, Refused()), say=lambda _: None, sleep=sleeps.append, clock=lambda: 0)
    assert sleeps == []


