def test_a_failed_env_lookup_stops_the_deploy(run):
    class Flaky(FakeVercel):
        def __call__(self, argv, stdin):
            if argv[1:3] == ["env", "ls"]:
                self.commands.append(argv)
                return 1, "", "temporary API failure"
            return super().__call__(argv, stdin)

    vercel = Flaky(existing_env={f"{PREFIX}_ENABLE_WRITES", f"{PREFIX}_REQUEST_STATE_KEY"})
    with pytest.raises(DeployError, match="env ls"):
        run(vercel=vercel)
    assert not vercel.env and not vercel.ran("deploy")  # nothing replaced, nothing deployed


def test_unreachable_hosts_are_retried_and_others_tried(run):
    class Unreachable(FakeSupabase):
        def __init__(self):
            super().__init__()
            self.failures = 2

        def __call__(self, method, url, headers, body):
            if "oauth-protected-resource" in url and url.startswith("https://new.example"):
                self.calls.append((method, url, dict(headers), None))
                raise DeployError("Couldn't reach new.example: DNS not ready")
            if "oauth-protected-resource" in url and self.failures:
                self.failures -= 1
                self.calls.append((method, url, dict(headers), None))
                raise DeployError(f"Couldn't reach {HOST}: connection reset")
            return super().__call__(method, url, headers, body)

    class TwoDomains(FakeVercel):
        def __call__(self, argv, stdin):
            if argv[1] == "inspect":
                self.commands.append(argv)
                return 0, json.dumps({"aliases": ["new.example", HOST]}), ""
            return super().__call__(argv, stdin)

    url, supabase, _ = run(supabase=Unreachable(), vercel=TwoDomains())
    assert url == RESOURCE


