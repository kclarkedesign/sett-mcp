class NoPublishableKey(FakeSupabase):
    def __call__(self, method, url, headers, body):
        if method == "POST" and url.endswith("/api-keys?reveal=true") and json.loads(body)["type"] == "publishable":
            self.calls.append((method, url, dict(headers), json.loads(body)))
            return 201, json.dumps({"type": "publishable", "api_key": "sb_publishable_new"}).encode()
        return super().__call__(method, url, headers, body)


