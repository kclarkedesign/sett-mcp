"""HTTP mode (`serve --http`): the edge cases that break real clients, and the SDK's
protections against requests from other websites."""

from __future__ import annotations

import json

import pytest
from starlette.testclient import TestClient

from {{ package_name }}.guardrails import Policy
from {{ package_name }}.server import build_server, http_app
from {{ package_name }}.store import ContactStore

HEADERS = {"content-type": "application/json", "accept": "application/json, text/event-stream"}
INITIALIZE = {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "test", "version": "1"}},
}


@pytest.fixture
def client():
    store = ContactStore([{"id": "c1", "name": "Ada", "email": "ada@example.org"}])
    server = build_server(policy=Policy(), store=store)
    with TestClient(http_app(server), base_url="http://127.0.0.1:8000") as test_client:
        yield test_client


def test_initialize_answers_with_plain_json(client):
    response = client.post("/mcp", json=INITIALIZE, headers=HEADERS)
    assert response.status_code == 200
    assert response.headers["content-type"].startswith("application/json")
    assert response.json()["result"]["serverInfo"]["name"]


def test_get_answers_405_instead_of_holding_a_stream_open(client):
    response = client.get("/mcp", headers={"accept": "text/event-stream"})
    assert response.status_code == 405
    assert response.headers["allow"] == "POST"
    assert response.json()["error"]["code"] == -32600


def test_delete_answers_405(client):
    assert client.delete("/mcp").status_code == 405


def test_requests_from_other_websites_are_refused(client):
    response = client.post("/mcp", json=INITIALIZE, headers={**HEADERS, "origin": "https://evil.example"})
    assert response.status_code == 403


def test_unexpected_host_is_refused(client):
    response = client.post("/mcp", json=INITIALIZE, headers={**HEADERS, "host": "evil.example"})
    assert response.status_code == 421


def test_unknown_paths_are_404_not_html(client):
    response = client.get("/.well-known/oauth-protected-resource")
    assert response.status_code == 404
    assert "html" not in response.headers.get("content-type", "")


def audited_call(tmp_path, *, user_agent, meta=None):
    """One get_contact call over stateless HTTP to a server that audits to a file; returns the audit rows.

    With `meta` it is a 2026-07-28 request carrying that envelope; without, a 2025-11-25 one with no
    handshake before it, which is how a stateless server sees a handshake client's calls.
    """
    log = tmp_path / "audit.jsonl"
    store = ContactStore([{"id": "c1", "name": "Ada", "email": "ada@example.org"}])
    server = build_server(policy=Policy(audit_path=log), store=store)
    tool = "{{ tool_prefix }}_get_contact"
    params = {"name": tool, "arguments": {"contact_id": "c1"}}
    headers = {**HEADERS, "user-agent": user_agent}
    if meta is None:
        headers["mcp-protocol-version"] = "2025-11-25"
    else:
        params["_meta"] = {"io.modelcontextprotocol/protocolVersion": "2026-07-28", "io.modelcontextprotocol/clientCapabilities": {}, **meta}
        headers |= {"mcp-protocol-version": "2026-07-28", "mcp-method": "tools/call", "mcp-name": tool}
    body = {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": params}
    with TestClient(http_app(server), base_url="http://127.0.0.1:8000") as test_client:
        response = test_client.post("/mcp", json=body, headers=headers)
    assert response.status_code == 200 and not response.json()["result"].get("isError")
    return [json.loads(line) for line in log.read_text().splitlines()]


def test_a_stateless_handshake_call_has_no_client_name_but_keeps_its_user_agent(tmp_path):
    # A 2025-11-25 client's initialize is a request of its own here, so the calls that follow arrive
    # without the client's name. The User-Agent header still says who it is.
    (row,) = audited_call(tmp_path, user_agent="Older Client/2.0")
    assert "client_name" not in row and "client_version" not in row
    assert row["user_agent"] == "Older Client/2.0"


def test_a_2026_call_names_the_client_from_its_request(tmp_path):
    info = {"io.modelcontextprotocol/clientInfo": {"name": "Newer Client", "version": "4.2"}}
    (row,) = audited_call(tmp_path, user_agent="Newer Client/4.2 (agent)", meta=info)
    assert (row["client_name"], row["client_version"]) == ("Newer Client", "4.2")
    assert row["user_agent"] == "Newer Client/4.2 (agent)"


def test_a_2026_call_without_client_info_leaves_the_name_empty(tmp_path):
    (row,) = audited_call(tmp_path, user_agent="Quiet Client/1.0", meta={})
    assert "client_name" not in row and "client_version" not in row
    assert row["user_agent"] == "Quiet Client/1.0"


def test_a_user_agent_is_untrusted_text_too(tmp_path):
    (row,) = audited_call(tmp_path, user_agent="x" * 5000)
    assert row["user_agent"] == "x" * 200
